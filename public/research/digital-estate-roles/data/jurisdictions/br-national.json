 "citations": [
  {
   "id": "br-cc-14",
   "cite": "Código Civil (Lei nº 10.406/2002), art. 14",
   "title": "Disposição do próprio corpo para depois da morte",
   "url": "https://www.planalto.gov.br/ccivil_03/leis/2002/l10406compilada.htm",
   "kind": "statute",
   "retrieved": "2026-09-17",
   "quote": "É válida, com objetivo científico, ou altruístico, a disposição gratuita do próprio corpo, no todo ou em parte, para depois da morte."
  },
  {
   "id": "br-cc-682",
   "cite": "Código Civil (Lei nº 10.406/2002), art. 682",
   "title": "Cessação do mandato",
   "url": "https://www.planalto.gov.br/ccivil_03/leis/2002/l10406compilada.htm",
   "kind": "statute",
   "retrieved": "2026-09-17",
   "quote": "Cessa o mandato: I - pela revogação ou pela renúncia; II - pela morte ou interdição de uma das partes"
  },
  {
   "id": "br-cc-1767",
   "cite": "Código Civil (Lei nº 10.406/2002), art. 1.767",
   "title": "Sujeitos a curatela",
   "url": "https://www.planalto.gov.br/ccivil_03/leis/2002/l10406compilada.htm",
   "kind": "statute",
   "retrieved": "2026-09-17",
   "quote": "Estão sujeitos a curatela: I - aqueles que, por causa transitória ou permanente, não puderem exprimir sua vontade"
  },
  {
   "id": "br-cc-1783a",
   "cite": "Código Civil (Lei nº 10.406/2002), art. 1.783-A",
   "title": "Tomada de decisão apoiada",
   "url": "https://www.planalto.gov.br/ccivil_03/leis/2002/l10406compilada.htm",
   "kind": "statute",
   "retrieved": "2026-09-17",
   "quote": "a pessoa com deficiência elege pelo menos 2 (duas) pessoas idôneas, com as quais mantenha vínculos e que gozem de sua confiança, para prestar-lhe apoio na tomada de decisão"
  },
  {
   "id": "br-cc-1784",
   "cite": "Código Civil (Lei nº 10.406/2002), art. 1.784",
   "title": "Transmissão da herança",
   "url": "https://www.planalto.gov.br/ccivil_03/leis/2002/l10406compilada.htm",
   "kind": "statute",
   "retrieved": "2026-09-17",
   "quote": "Aberta a sucessão, a herança transmite-se, desde logo, aos herdeiros legítimos e testamentários."
  },
  {
   "id": "br-cc-1976",
   "cite": "Código Civil (Lei nº 10.406/2002), art. 1.976",
   "title": "Nomeação de testamenteiro",
   "url": "https://www.planalto.gov.br/ccivil_03/leis/2002/l10406compilada.htm",
   "kind": "statute",
   "retrieved": "2026-09-17",
   "quote": "O testador pode nomear um ou mais testamenteiros, conjuntos ou separados, para lhe darem cumprimento às disposições de última vontade."
  },
  {
   "id": "br-cc-1991",
   "cite": "Código Civil (Lei nº 10.406/2002), art. 1.991",
   "title": "Administração pelo inventariante",
   "url": "https://www.planalto.gov.br/ccivil_03/leis/2002/l10406compilada.htm",
   "kind": "statute",
   "retrieved": "2026-09-17",
   "quote": "Desde a assinatura do compromisso até a homologação da partilha, a administração da herança será exercida pelo inventariante."
