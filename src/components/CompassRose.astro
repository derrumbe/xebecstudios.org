---
/**
 * A mariner's compass rose, with the 32-point rhumb network anchored to it.
 *
 * Eight points, each split lengthwise into a filled and an outlined half so it
 * reads as faceted metal rather than as a symbol. North is the red one — that's
 * a navigational convention, and it puts the accent colour somewhere it means
 * something. The bezel carries the same 32 divisions as the bearings, so the
 * rose and the lines are visibly the same instrument.
 *
 * The lines are a fixed-size SVG centred on this element with z-index -1, so
 * they follow the rose wherever CSS puts it. Do not try to align them by
 * viewBox coordinates — that drifts with the viewport and lands on the margin
 * text at some widths.
 */
interface Props {
  size?: number;
  /** 32 for the home page, 9 for an article header, 0 for the rose alone. */
  bearings?: number;
  class?: string;
}
const { size = 150, bearings = 32, class: className = '' } = Astro.props;

const c = size / 2;
const Rmaj = size * 0.387;
const Rmin = size * 0.34;
const ring = size * 0.427;
const tick = size * 0.04;

/**
 * Arm half-width as a fraction of that arm's own length, so a short point and
 * a long one taper identically. A single shared width — which is what this
 * used to be — makes the four half-wind points 45% fatter in proportion than
 * the principal ones, and eight arms that disagree about their taper read as
 * a lopsided star even when the geometry is exact.
 *
 * The half-winds now reach 88% of a principal point rather than 69%, so the
 * star reads as eight points rather than four with packing between them.
 */
const TAPER = 0.105;
/** Covers the junction where all sixteen triangles meet. Keep it >= the
 *  widest arm base, or the overlap shows as a blob instead of a boss. */
const hub = size * 0.045;

const P = (r: number, deg: number): [number, number] => {
  const a = (deg * Math.PI) / 180;
  return [c + r * Math.cos(a), c + r * Math.sin(a)];
};
const F = ([x, y]: [number, number]) => `${x.toFixed(1)},${y.toFixed(1)}`;

const ticks = Array.from({ length: 32 }, (_, i) => {
  const d = i * 11.25 - 90;
  const [x1, y1] = P(ring, d);
  const [x2, y2] = P(ring + tick, d);
  return { cls: i % 4 === 0 ? 'tk-p' : i % 2 === 0 ? 'tk-h' : 'tk-q', x1, y1, x2, y2 };
});

// Minor points first so the majors sit over them.
const points = [
  [45, Rmin], [135, Rmin], [225, Rmin], [315, Rmin],
  [0, Rmaj], [90, Rmaj], [180, Rmaj], [270, Rmaj],
].map(([deg, R]) => {
  const d = deg - 90;
  const half = R * TAPER;
  return {
    // The whole kite, drawn in paper beneath the two halves. The arms are
    // translucent by design, so without this the rhumb lines read straight
    // through them and the star looks like it is made of gauze. The backing
    // occludes the ray field so each arm renders against paper, exactly as it
    // does everywhere the lines do not reach.
    base: `${F(P(R, d))} ${F(P(half, d - 90))} ${c},${c} ${F(P(half, d + 90))}`,
    solid: `${F(P(R, d))} ${F(P(half, d - 90))} ${c},${c}`,
    open: `${F(P(R, d))} ${F(P(half, d + 90))} ${c},${c}`,
    north: d === -90,
  };
});

const uid = Math.random().toString(36).slice(2, 8);


const lineIdx =
  bearings >= 32 ? Array.from({ length: 32 }, (_, i) => i)
  : bearings > 0 ? Array.from({ length: bearings }, (_, i) => i - Math.floor(bearings / 2))
  : [];
---

<div class:list={['rose-node', className]} style={`width:${size}px`}>
  {lineIdx.length > 0 && (
    <svg class="lines" viewBox="0 0 2600 2600" aria-hidden="true">
      {/*
        The rays are 1300 long — exactly the half-viewBox — so the square
        viewport never crops them. They used to run to 2000 and be cut by the
        edge, which left them 41% longer into the corners than along the axes
        and made the whole field read as a rectangle rather than a chart.

        The mask then dissolves them outward on a circle, so they carry through
        the rose at full strength and there is no hard rim where they stop.
      */}
      <defs>
        <radialGradient id={`fade-${uid}`}>
          <stop offset="0%" stop-color="#fff" stop-opacity="1" />
          <stop offset="45%" stop-color="#fff" stop-opacity="1" />
          <stop offset="100%" stop-color="#fff" stop-opacity="0" />
        </radialGradient>
        <mask id={`rhumb-${uid}`}>
          <rect width="2600" height="2600" fill={`url(#fade-${uid})`} />
        </mask>
      </defs>
      <g mask={`url(#rhumb-${uid})`}>
        {lineIdx.map((i) => (
          <line
            class={i % 4 === 0 ? 'w-p' : i % 2 === 0 ? 'w-h' : 'w-q'}
            x1="1300" y1="1300" x2="2600" y2="1300"
            transform={i === 0 ? undefined : `rotate(${i * 11.25} 1300 1300)`}
          />
        ))}
      </g>
    </svg>
  )}
  <svg class="rose" viewBox={`0 0 ${size} ${size}`} aria-hidden="true">
    <circle class="bez" cx={c} cy={c} r={ring} />
    <circle class="bez" cx={c} cy={c} r={ring + tick} />
    {ticks.map((t) => (
      <line class={t.cls} x1={t.x1.toFixed(1)} y1={t.y1.toFixed(1)} x2={t.x2.toFixed(1)} y2={t.y2.toFixed(1)} />
    ))}
    {points.map((p) => (
      <>
        <polygon class="pt-base" points={p.base} />
        <polygon class={p.north ? 'pt-n' : 'pt-solid'} points={p.solid} />
        <polygon class="pt-open" points={p.open} />
      </>
    ))}
    <circle class="pt-base" cx={c} cy={c} r={hub.toFixed(1)} />
    <circle class="hub" cx={c} cy={c} r={hub.toFixed(1)} />
  </svg>
</div>
