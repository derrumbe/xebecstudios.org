---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import '../../../styles/der.css';
import { fmtDate } from '../../../consts';

/**
 * One advisory document.
 *
 * These render as the viewer's Findings tab does — the .der type scale and the
 * .prose measure from der.css — rather than as a site essay. They are research
 * output, they carry most of their argument in wide tables, and sitting them in
 * the essay chrome (Spectral at 19.5px on a 34rem measure, with a drop cap) both
 * cramped the tables and implied a kind of authorship these do not have.
 *
 * .prose gives text a 56ch measure and tables 82ch, which is the same split the
 * findings page uses. Not .der-static: that restyles h2 into a small uppercase
 * label, which suits a role page's field headings and would flatten these
 * documents' sections.
 *
 * The prose itself is authored in the digital-estate-roles repository and copied
 * into src/content/research/, so the body here is rendered markdown and nothing
 * more — no viewer script, no data fetch.
 */
export async function getStaticPaths() {
  const docs = await getCollection('research', (d) => d.data.section === 'digital-estate-standards');
  return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={d.title} description={d.description} type="article">
  <div class="wrap">
    <section class="band">
      <div class="der">
        <div class="prose">
          <p class="crumb"><a href="/research/digital-estate-standards/">Digital Estate Standards</a></p>
          <h1>{d.title}</h1>
          <!-- The standing line used to sit in a Margin sidebar. It is the signal
               that these pages are argument rather than sourced law, so it keeps
               its place directly under the title. -->
          <p class="standing">{d.standing}</p>
          <Content />
          <p class="doc-foot">
            {d.updated ? <>Written {fmtDate(d.updated, true)}. </> : null}
            <a href="/research/digital-estate-standards/">All three documents</a> &middot;
            <a href="/research/digital-estate-roles/">the sourced reference</a>, which carries the citations.
          </p>
        </div>
      </div>
    </section>
  </div>
</Base>
