---
import Base from '../../../layouts/Base.astro';
import Margin from '../../../components/Margin.astro';
import '../../../styles/der.css';

/**
 * The Digital Estate Roles viewer.
 *
 * The markup below is the tab and control structure the viewer script expects;
 * it is driven entirely by src/scripts/der/app.js, which fills every element
 * with an id. The data is committed under public/research/digital-estate-roles/
 * data/ and regenerated by scripts/sync-xebec.sh in the digital-estate-roles
 * repo — it is not built here.
 *
 * The viewer's own masthead and footer are not reproduced: the page title, the
 * standing note and the theme control all belong to the site.
 */
const DATA = '/research/digital-estate-roles/data/';
const retrieved = '17 September 2026';
---

<Base
  title="Digital Estate Roles"
  description="When legal authority over a person, their property and their digital estate is assigned, when it starts, and when it ends — sourced to statute, regulation and official policy, across nine countries."
>
  <div class="wrap">
    <section class="band">
      <div class="grid" style="margin-bottom:22px">
        <Margin
          label="Digital Estate Roles"
          notes={[
            { note: `Not legal advice. A research aid summarising primary sources as retrieved on the dates shown — most recently ${retrieved}.` },
            { note: 'Uniform acts are models. They bind nobody until a state enacts them, and states change them on the way through.', tone: 'aside' },
          ]}
        />
        <div>
          <p class="lede">
            Authority over a person and their property is handed over in pieces, at different
            moments, by different instruments. This maps when each role is <b>assigned</b>, when it
            <b>starts</b>, and when it <b>ends</b> — across the United States, the United Kingdom,
            Canada, Australia, Germany, Spain, Sweden, Finland and Denmark.
          </p>
        </div>
      </div>

      <div class="der" data-der data-base={DATA}>
        <header class="top">
          <div class="top-inner">
            <div class="controls">
              <label class="field">
                <span>Jurisdiction</span>
                <select id="jur"></select>
              </label>
            </div>
          </div>
          <nav class="tabs" role="tablist">
            <button role="tab" data-tab="lanes">Lifecycle</button>
            <button role="tab" data-tab="role">Role detail</button>
            <button role="tab" data-tab="compare">Compare</button>
            <button role="tab" data-tab="trends">Trends</button>
            <button role="tab" data-tab="sources">Sources</button>
          </nav>
        </header>

        <p id="jur-note" class="jur-note"></p>

        <section id="tab-lanes" class="tab" hidden>
          <div class="toolbar">
            <div id="groups" class="chips" aria-label="Filter by group"></div>
            <div class="legend" aria-label="Legend">
              <span><i class="lg lg-assigned"></i>assigned</span>
              <span><i class="lg lg-dormant"></i>dormant</span>
              <span><i class="lg lg-start"></i>authority starts</span>
              <span><i class="lg lg-active"></i>active</span>
              <span><i class="lg lg-end"></i>ends</span>
              <span><i class="lg lg-diff"></i>differs from US model</span>
            </div>
          </div>
          <div id="lanes" class="scroll-x"></div>
          <p class="hint">
            Hover or tap a marker for the triggering event and citation. An ✕ at the start of a later
            phase is a boundary end (death, closing); ✕ marks on the active bar are ends that can
            occur at any time (revocation, removal, restored capacity). Click a role name to open its
            state machine.
          </p>
          <aside id="tip" class="tip" hidden></aside>
        </section>

        <section id="tab-role" class="tab" hidden>
          <div class="toolbar">
            <label class="field grow"><span>Role</span><select id="role-select"></select></label>
          </div>
          <div id="role-detail"></div>
        </section>

        <section id="tab-compare" class="tab" hidden>
          <p class="lede">
            Roles are lined up by what they do, with each jurisdiction’s own statutory name. Choose a
            country, or compare all of them. For US states, cells that differ from the uniform/model
            baseline carry a rule and an italic label.
          </p>
          <div id="compare" class="scroll-x"></div>
        </section>

        <section id="tab-trends" class="tab" hidden><div id="trends"></div></section>
        <section id="tab-sources" class="tab" hidden><div id="sources"></div></section>
      </div>

      <div class="grid" style="margin-top:26px">
        <Margin label="Standing note" />
        <div>
          <p class="foot-note">
            <b>Not legal advice.</b> This is a research aid summarising primary legal sources as
            retrieved on the dates shown. Always read the cited current text and consult a lawyer
            licensed in the jurisdiction. Claims without a verified primary-source citation are drawn
            dashed and labelled <em>unverified</em>.
          </p>
          <p class="foot-note">
            Part of research for the
            <a href="https://github.com/dhs-aws/death-and-the-digital-estate">Death and the Digital Estate</a>
            effort.
          </p>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  import '../../../scripts/der/app.js';
</script>

<style>
  .foot-note { font-size: 15.5px; color: var(--ink-soft); margin: 0 0 10px; max-width: var(--measure); }
  .foot-note a { color: var(--lapis); text-underline-offset: 3px; }
</style>
