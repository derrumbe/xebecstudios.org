---
import Base from '../../../../layouts/Base.astro';
import '../../../../styles/der.css';
import { readFileSync } from 'node:fs';

/**
 * Report a gap, a mistake, or something missing for your jurisdiction.
 *
 * The form posts to the Worker route in worker/index.js, which files a GitHub issue using
 * a token it holds. GitHub is the destination; nobody needs an account to reach it. The
 * page is prefilled from query parameters so that a reader arriving from a role page does
 * not have to explain which page they meant.
 */
const { roles } = JSON.parse(
  readFileSync('public/research/digital-estate-roles/data/canonicals.json', 'utf8'),
);
const manifest = JSON.parse(
  readFileSync('public/research/digital-estate-roles/data/manifest.json', 'utf8'),
);

// A Turnstile site key is public by design — it is rendered into the HTML of this page,
// so keeping it out of the repository would protect nothing. It lives here beside the form
// that uses it; the environment variable stays supported so it can be changed without a
// code change. The *secret* key is a Worker secret and is not here.
const SITEKEY = import.meta.env.PUBLIC_TURNSTILE_SITEKEY || '0x4AAAAAAE7UQBvkDaWZmYB5';

// A reader should never have to read an id. The form shows the names the viewer shows —
// 'Finland', not 'fi-national' — and resolves back to the id behind the scenes, so triage
// keeps the exact row. A name we do not know is still accepted: someone reporting a
// jurisdiction that is not covered has no id to give, and that is the report we most want.
const jurOptions = manifest.jurisdictions.map((j: any) => ({ id: j.id, name: j.label || j.name }));
const roleOptions = roles.map((r: any) => ({ id: r.id, name: r.label }));
// Per-row links on a role page carry that jurisdiction's own role id, not the canonical one,
// so both have to resolve. The statutory name leads, with the official English gloss after it.
const roleAliases: Record<string, string> = {};
for (const r of roles) {
  for (const j of r.jurisdictions) {
    roleAliases[j.roleId] = j.nameEn && j.nameEn.en && j.nameEn.en !== j.roleName
      ? `${j.roleName} — ${j.nameEn.en}`
      : j.roleName;
  }
}
const NAMES = { jur: jurOptions, role: roleOptions, roleAliases };
---

<Base
  title="Report a gap — Digital Estate Roles"
  description="Tell us what is missing, wrong or unclear for your jurisdiction. No account needed."
>
  <div class="wrap">
    <section class="band">
      <div class="der der-static">
        <header class="static-head">
          <p class="crumb">
            <a href="/research/digital-estate-roles/">Digital Estate Roles</a> ·
            <a href="/research/digital-estate-roles/roles/">Roles</a>
          </p>
          <h1>Report a gap</h1>
          <p class="lede">
            If you work with this law where you are and something here is missing, wrong, or
            out of date, this is the place to say so. You do not need an account of any kind —
            what you write is filed for us to work through.
          </p>
          <p class="counts">
            What helps most: which jurisdiction, what the law actually provides, and a link to
            the statute or regulation if you have one. Everything here is sourced to primary
            law, so a pointer to the text is what lets a correction be made.
          </p>
        </header>

        <form method="POST" action="/research/digital-estate-roles/feedback/" class="fb-form">
          <label>
            <span>What kind of thing is it?</span>
            <select name="kind">
              <option value="gap" >Something is missing</option>
              <option value="correction" >Something is wrong or out of date</option>
              <option value="unclear" >Something is unclear</option>
              <option value="jurisdiction" >A jurisdiction you would like covered</option>
            </select>
          </label>

          <label>
            <span>Jurisdiction</span>
            <input list="jur-list" name="jurisdiction" placeholder="e.g. New South Wales, or Finland" autocomplete="off" />
            <datalist id="jur-list">
              {jurOptions.map((j) => <option value={j.name}>{j.id}</option>)}
            </datalist>
            <input type="hidden" name="jurisdiction_id" value="" />
          </label>

          <label>
            <span>Role, if it is about one</span>
            <input list="role-list" name="role" placeholder="e.g. enduring guardian" autocomplete="off" />
            <datalist id="role-list">
              {roleOptions.map((r) => <option value={r.name}>{r.id}</option>)}
            </datalist>
            <input type="hidden" name="role_id" value="" />
          </label>

          <label>
            <span>What is missing or wrong?</span>
            <textarea name="body" rows="7" required minlength="20"
              placeholder="In New South Wales an enduring guardian can also…"></textarea>
          </label>

          <label>
            <span>A link to the statute or regulation, if you have one</span>
            <input type="url" name="source" placeholder="https://legislation.nsw.gov.au/…" />
          </label>

          <label>
            <span>How to reach you, if you would like a reply <em>(optional)</em></span>
            <input name="contact" placeholder="email, or leave blank" />
          </label>

          <input type="hidden" name="page" value="" />
          <input type="hidden" name="subject" value="" />
          <p class="hp" aria-hidden="true">
            <label>Leave this blank<input name="website" tabindex="-1" autocomplete="off" /></label>
          </p>

          {SITEKEY && <div class="cf-turnstile" data-sitekey={SITEKEY}></div>}

          <button type="submit">Send</button>
          <p class="hint">
            What you send is filed as an issue for us to work through. Please do not include
            anything confidential, and note that it is a research aid, not legal advice — we
            cannot answer questions about your own situation.
          </p>
        </form>
      </div>
    </section>
  </div>
  <script is:inline define:vars={{ NAMES }}>
    // Convenience only: arriving from a role page carries the context, but the form is
    // complete without it, because the page is prerendered and this may not run.
    (() => {
      const field = (name) => document.querySelector(`[name="${name}"]`);
      const set = (name, value) => { const el = field(name); if (el && value) el.value = value; };

      const jurName = new Map(NAMES.jur.map((j) => [j.id, j.name]));
      const jurId = new Map(NAMES.jur.map((j) => [j.name.toLowerCase(), j.id]));
      // Canonical ids last, so a link from a canonical role page gets the canonical wording
      // even where a jurisdiction happens to use the same id for its own role.
      const roleName = new Map([
        ...Object.entries(NAMES.roleAliases),
        ...NAMES.role.map((r) => [r.id, r.name]),
      ]);
      const roleId = new Map(NAMES.role.map((r) => [r.name.toLowerCase(), r.id]));
      // A reader who does know the id and types it should not be treated as naming something
      // we have never heard of, so ids resolve to themselves.
      for (const [id] of jurName) jurId.set(id.toLowerCase(), id);
      for (const r of NAMES.role) roleId.set(r.id.toLowerCase(), r.id);

      // A link carries ids; show the name and keep the id in the field beside it.
      const prefill = (visible, hidden, id, names) => {
        if (!id) return;
        set(hidden, id);
        set(visible, names.get(id) || id);
      };
      const q = new URLSearchParams(location.search);
      prefill('jurisdiction', 'jurisdiction_id', q.get('j'), jurName);
      prefill('role', 'role_id', q.get('role'), roleName);
      set('page', q.get('page') || document.referrer || '');
      const kind = q.get('kind');
      if (kind) set('kind', kind);

      // And when a reader picks or types a name themselves, resolve it back to an id — or
      // clear a stale one, so a name we do not know is never filed under somebody else's id.
      const track = (visible, hidden, ids) => {
        const el = field(visible), h = field(hidden);
        if (!el || !h) return;
        el.addEventListener('input', () => { h.value = ids.get(el.value.trim().toLowerCase()) || ''; });
      };
      track('jurisdiction', 'jurisdiction_id', jurId);
      track('role', 'role_id', roleId);
    })();
  </script>
  {SITEKEY && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</Base>
